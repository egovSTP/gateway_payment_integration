        "apiKey": "your-api-key",
        "clientKey": "your-merchant-login",
        "idempotencyKey": "unique-idempotency-key"
      },
      "body": {
        "provider": "SAOWALLET",
        "amount": 100.00,
        "currency": "USD",
        "name": "Invoice Name",
        "payerContact": "+1234567890",
        "providerId": "your-sdk-finance-provider-id"
      }
    },
    {
      "name": "Create Payment - DOBRADIGITAL",
      "defaultRequest": false,
      "method": "POST",
      "headers": {
        "Content-Type": "application/json",
        "clientKey": "your-client-key"
      },
      "body": {
        "provider": "DOBRADIGITAL",
        "amount": 50.00,
        "reference": "1234",
        "services": []
      }
    }
  ],
